<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Example LaunchAgent for devsignal. `devsignal init` generates and loads this for you;
  see the LaunchAgent section of README.md to do it by hand.

  Placeholders substituted at install time:
    /REPLACE/WITH/ABSOLUTE/PATH/TO/devsignal  absolute path to the binary
    REPLACE_HOME                              your home directory

  Note: XML comments cannot contain a double hyphen, so command lines with flags
  are documented in README.md rather than here.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.devsignal.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/REPLACE/WITH/ABSOLUTE/PATH/TO/devsignal</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPLACE_HOME/Library/Logs/devsignal/devsignal.out.log</string>

  <key>StandardErrorPath</key>
  <string>REPLACE_HOME/Library/Logs/devsignal/devsignal.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>info</string>
  </dict>
</dict>
</plist>
